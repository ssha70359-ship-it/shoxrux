# ============================================================
#  AI-konsultant bot — muhit o'zgaruvchilari
#  Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring:
#      cp .env.example .env
# ============================================================

# --- Telegram ---
# @BotFather dan olinadigan token
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Admin(lar)ning Telegram ID si. Bir nechta bo'lsa vergul bilan: 111,222,333
# O'z ID ingizni @userinfobot dan bilib olasiz.
ADMIN_ID=123456789

# --- AI provayder ---
# "anthropic" (tavsiya etiladi) yoki "openai"
AI_PROVIDER=anthropic

# Anthropic Claude uchun
ANTHROPIC_API_KEY=sk-ant-...
# Joriy modellar: claude-haiku-4-5 (eng arzon va tez, sukut bo'yicha),
#                 claude-sonnet-5 (o'rtacha), claude-opus-5 (eng kuchli)
ANTHROPIC_MODEL=claude-haiku-4-5
# Javob chuqurligi: low | medium | high | xhigh | max
# DIQQAT: Haiku bu sozlamani qo'llab-quvvatlamaydi va u e'tiborsiz
# qoldiriladi. Opus yoki Sonnet'ga o'tsangiz ishlay boshlaydi —
# konsultant-bot uchun "low" yetarli.
AI_EFFORT=low

# OpenAI uchun (AI_PROVIDER=openai bo'lsa kerak)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Javob uzunligi chegarasi (token)
AI_MAX_TOKENS=1024

# --- Kompaniya ma'lumotlari (System Prompt shulardan yasaladi) ---
COMPANY_NAME=Sunrise Digital
COMPANY_FIELD=veb-sayt va mobil ilova ishlab chiqish
COMPANY_INFO=Ish vaqti: Du-Sha 09:00-18:00. Aloqa: +998 90 123 45 67. Sayt: sunrise.uz
BOT_PERSONA_NAME=Aziza

# --- Operator bilan bog'lanish ---
# Menyudagi "Operatorga yozish" tugmasi shu username'ga havola qiladi.
# Ikkalasi ham bo'sh bo'lsa, tugma umuman ko'rsatilmaydi.
OPERATOR_USERNAME=@sunrise_manager
OPERATOR_PHONE=+998901234567

# --- Til ---
# Yangi foydalanuvchi uchun sukutdagi til: uz | ru | en
# (Telegram interfeysi tili uz/ru/en bo'lsa, avtomatik o'sha til tanlanadi)
DEFAULT_LANGUAGE=uz

# --- Suhbat xotirasi ---
# Kontekstga qo'shiladigan oxirgi xabarlar soni (5-10 tavsiya etiladi)
HISTORY_LIMIT=10

# --- Ma'lumotlar bazasi ---
DB_PATH=data/bot.db

# --- Xabar oqimini cheklash (anti-spam), soniyada ---
THROTTLE_RATE=1.0

# --- Ommaviy xabar tezligi: sekundiga nechta xabar (Telegram limiti ~30) ---
BROADCAST_RATE=20

# --- Loglash darajasi: DEBUG | INFO | WARNING | ERROR ---
LOG_LEVEL=INFO
